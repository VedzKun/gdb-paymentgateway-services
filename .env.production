# Payment Gateway Service - Production Environment
ENVIRONMENT=production
DEBUG=False
PORT=8008
LOG_LEVEL=INFO

# Database (will be replaced by Render)
DATABASE_URL=postgresql://user:password@host:5432/database?options=-csearch_path%3Dpayment_gateway_service

# JWT Configuration
JWT_SECRET_KEY=your-production-jwt-secret-key
JWT_ALGORITHM=HS256

# Payment Gateway Configuration
GATEWAY_API_KEY=your-payment-gateway-api-key
GATEWAY_SECRET_KEY=your-payment-gateway-secret-key

# CORS
CORS_ALLOWED_ORIGINS=*
